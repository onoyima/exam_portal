# =============================================================================
# Veritas University - Integrated Learning Management System (ILMS)
# Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# APPLICATION SETTINGS
# ---------------------------------------------------------------------------
APP_ENV=production
# Options: development, testing, staging, production

APP_DEBUG=false
# WARNING: Set to false in production - exposes sensitive information when true

APP_URL=https://lms.veritas.edu.ng
# Canonical URL of the LMS instance (no trailing slash)

APP_BASE_PATH=/exam_portal/lms/public
# Base path relative to web server root - matches the existing exam_portal directory structure

APP_TIMEZONE=Africa/Lagos
# PHP timezone - Veritas University, Abuja (WAT: UTC+1)

APP_LOCALE=en
# Default application locale/language

APP_ENCRYPTION_KEY=
# 32-byte hex key for AES-256 encryption of sensitive data at rest
# Generate: php -r "echo bin2hex(random_bytes(32));"

# ---------------------------------------------------------------------------
# LMS PRIMARY DATABASE CONNECTION
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_db
DB_USERNAME=lms_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# EXEAT2 (EXAM PORTAL) DATABASE CONNECTION
# ---------------------------------------------------------------------------
# Separate connection for the existing exam portal database for cross-system queries
EXEAT2_DB_HOST=127.0.0.1
EXEAT2_DB_PORT=3306
EXEAT2_DB_DATABASE=exeat2_db
EXEAT2_DB_USERNAME=lms_user
EXEAT2_DB_PASSWORD=
EXEAT2_DB_CHARSET=utf8mb4
EXEAT2_DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# JWT AUTHENTICATION
# ---------------------------------------------------------------------------
JWT_SECRET=
# Minimum 32 characters - use a cryptographically random string
# Generate: php -r "echo bin2hex(random_bytes(32));"

JWT_TTL=3600
# Access token lifetime in seconds (default: 1 hour)

JWT_REFRESH_TTL=2592000
# Refresh token lifetime in seconds (default: 30 days)

JWT_ALGORITHM=HS256
# JWT signing algorithm (HS256, HS384, HS512)

JWT_ISSUER=veritas-lms
JWT_AUDIENCE=veritas-university

# ---------------------------------------------------------------------------
# REDIS CONFIGURATION
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=LMS_
# All Redis keys will be prefixed with this to avoid collisions

REDIS_SESSION_DB=1
# Separate Redis database for sessions (isolated from cache data)

REDIS_CACHE_DB=2
# Redis database for application cache

REDIS_QUEUE_DB=3
# Redis database for queue when using Redis as queue driver (fallback)

# ---------------------------------------------------------------------------
# MAIL / SMTP CONFIGURATION
# ---------------------------------------------------------------------------
MAIL_DRIVER=smtp
# Options: smtp, sendmail, log (log to storage/logs for development), array

MAIL_HOST=smtp.veritas.edu.ng
MAIL_PORT=587
MAIL_USERNAME=lms@notify.veritas.edu.ng
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Options: tls, ssl, null

MAIL_FROM_ADDRESS=lms@veritas.edu.ng
MAIL_FROM_NAME="Veritas Learning Management System"

MAIL_REPLY_TO_ADDRESS=noreply@veritas.edu.ng

# ---------------------------------------------------------------------------
# LMS SYSTEM SETTINGS
# ---------------------------------------------------------------------------
LMS_NAME="Veritas Learning Management System"
LMS_VERSION=1.0.0
LMS_TIMEZONE=Africa/Lagos
LMS_LOCALE=en

LMS_STORAGE_DRIVER=local
# Options: local, s3, minio
# For production, use s3 or minio (S3-compatible object storage)

LMS_STORAGE_PATH=/var/www/html/lms/storage/media
# Local filesystem path when using 'local' driver

LMS_STORAGE_BUCKET=veritas-lms-media
# S3/MinIO bucket name

LMS_STORAGE_REGION=eu-west-1
# AWS region or MinIO region

LMS_STORAGE_ENDPOINT=
# S3-compatible endpoint (leave empty for AWS S3, set for MinIO)
# Example: https://minio.veritas.edu.ng

LMS_STORAGE_USE_PATH_STYLE=false
# Set to true for MinIO (path-style URLs), false for AWS S3 (virtual-hosted)

LMS_STORAGE_ACCESS_KEY_ID=
LMS_STORAGE_SECRET_ACCESS_KEY=

LMS_LOG_LEVEL=warning
# Options: debug, info, notice, warning, error, critical, alert, emergency

LMS_LOG_CHANNEL=stack
# Options: stack (all), single, daily, syslog, errorlog

LMS_LOG_DAILY_DAYS=30
# Retention days for daily log channel

LMS_CACHE_DRIVER=redis
# Options: redis, file, array (array for testing)

LMS_SESSION_DRIVER=redis
# Options: redis, file, database

LMS_QUEUE_DRIVER=rabbitmq
# Options: rabbitmq, redis, sync (sync for development)

LMS_PAGINATION_PER_PAGE=20
LMS_MAX_UPLOAD_SIZE=104857600
# Maximum upload size in bytes (default: 100MB)

LMS_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,gif,mp4,webm,zip,scorm,h5p
# Comma-separated list of allowed file extensions for upload

LMS_DEFAULT_PASSING_GRADE=50
# Default minimum percentage to pass quizzes/assignments

LMS_ENABLE_SELF_REGISTRATION=false
# Allow users to register themselves (typically disabled for institutional use)

LMS_ENABLE_ANALYTICS=true
LMS_ENABLE_AI_FEATURES=false
LMS_ENABLE_MAINTENANCE_MODE=false

# ---------------------------------------------------------------------------
# RABBITMQ (EVENT BUS / QUEUE)
# ---------------------------------------------------------------------------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=lms_queue
RABBITMQ_PASS=
RABBITMQ_VHOST=lms_vhost

RABBITMQ_MANAGEMENT_PORT=15672
# RabbitMQ Management UI port

RABBITMQ_EXCHANGE_EVENTS=lms.events
# Topic exchange for all domain events

RABBITMQ_EXCHANGE_DLX=lms.dlx
# Dead letter exchange for failed messages

RABBITMQ_EXCHANGE_DELAYED=lms.delayed
# Delayed message exchange

RABBITMQ_PREFETCH_COUNT=10
# Number of messages to prefetch per consumer

RABBITMQ_HEARTBEAT=60
# AMQP heartbeat interval in seconds

# ---------------------------------------------------------------------------
# EXAM PORTAL INTEGRATION
# ---------------------------------------------------------------------------
EXAM_PORTAL_URL=https://portal.veritas.edu.ng
EXAM_PORTAL_API_VERSION=v1
EXAM_PORTAL_API_KEY=
# Shared API key for server-to-server authentication

EXAM_PORTAL_SSO_ENABLED=true
EXAM_PORTAL_SSO_TOKEN_TTL=300
# SSO token lifetime in seconds (5 minutes)

EXAM_PORTAL_WEBHOOK_SECRET=
# Secret for HMAC-SHA256 verification of incoming webhooks

EXAM_PORTAL_SYNC_ENABLED=true
EXAM_PORTAL_SYNC_INTERVAL=300
# Automatic sync interval in seconds (5 minutes)

EXAM_PORTAL_SYNC_BATCH_SIZE=500
# Number of records per sync batch

EXAM_PORTAL_GRADE_PASSBACK_ENABLED=true

# ---------------------------------------------------------------------------
# WEBHOOK SETTINGS (OUTGOING)
# ---------------------------------------------------------------------------
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAY=30
# Base delay in seconds (exponential backoff applied)

WEBHOOK_TIMEOUT=30
# HTTP timeout for webhook delivery in seconds

# ---------------------------------------------------------------------------
# RATE LIMITING
# ---------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=100
API_RATE_LIMIT_BURST=150
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---------------------------------------------------------------------------
# CORS SETTINGS
# ---------------------------------------------------------------------------
API_CORS_ALLOWED_ORIGINS=https://lms.veritas.edu.ng,https://portal.veritas.edu.ng
# Comma-separated list of allowed origins

API_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
API_CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID,X-API-Version
API_CORS_MAX_AGE=86400

# ---------------------------------------------------------------------------
# SECURITY SETTINGS
# ---------------------------------------------------------------------------
SESSION_LIFETIME=120
# Session lifetime in minutes (2 hours)

PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900
# Account lockout duration in seconds (15 minutes)

TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER="Next Gen LMS"

# ---------------------------------------------------------------------------
# FILE UPLOAD / MEDIA
# ---------------------------------------------------------------------------
MEDIA_IMAGE_MAX_WIDTH=2048
MEDIA_IMAGE_MAX_HEIGHT=2048
MEDIA_VIDEO_MAX_SIZE=524288000
# 500MB for video uploads

MEDIA_ENABLE_TRANSCODING=false
MEDIA_ENABLE_OPTIMIZATION=true

# ---------------------------------------------------------------------------
# CACHE TTL SETTINGS (seconds)
# ---------------------------------------------------------------------------
CACHE_TTL_DEFAULT=600
# Default cache TTL: 10 minutes

CACHE_TTL_SESSION=3600
# Session cache TTL: 1 hour

CACHE_TTL_QUERY=300
# Query result cache TTL: 5 minutes

CACHE_TTL_COURSE=600
CACHE_TTL_USER=3600
CACHE_TTL_GRADEBOOK=120

# ---------------------------------------------------------------------------
# SUPERVISOR / QUEUE WORKER SETTINGS
# ---------------------------------------------------------------------------
WORKER_MAIL_MAX_JOBS=100
WORKER_SYNC_MAX_JOBS=50
WORKER_EVENTS_MAX_JOBS=100
WORKER_SLEEP_INTERVAL=3
# Seconds to sleep between queue polls when idle

# ---------------------------------------------------------------------------
# SENTRY (ERROR TRACKING)
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0

# ---------------------------------------------------------------------------
# OPENTELEMETRY / TRACING
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=veritas-lms
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
